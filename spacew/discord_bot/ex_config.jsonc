// you must rename this file to "config.json" for it to work
{
    "token": "put token here",
    "default_message": "{cli.main(['-nam', 'all'])}",
    "status": {
        "enabled": true,
        "channel": "put status channel id here",
        "edit": true,
        "edit_message": "put message id to edit here, if edit = false, this is not needed",
        "message": null // if it's null, it's replaced with default_message
    },
    "alerts": {
        "enabled": true,
        "channel": "put alerts channel id here",
        "alerts": [
            {
                "check": "int(now.kp[0])>=7",
                "message": "@everyone aurora activity is currently very high (Kp{now.kp}/G{now.g})"
            }
        ]
    }
}